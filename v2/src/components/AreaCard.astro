---
interface Props {
  titulo: string;
  resumo: string;
  href: string;
}
const { titulo, resumo, href } = Astro.props;
---

<article class="area-card reveal">
  <a href={href}>
    <h3>{titulo}</h3>
    <p>{resumo}</p>
  </a>
</article>

<style>
  .area-card {
    border: 1px solid var(--brown-medium);
    border-radius: 6px;
    padding: var(--space-3);
    background: var(--paper);
    transition: border-color 0.2s ease;
  }
  .area-card h3 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    margin: 0 0 var(--space-1) 0;
    color: var(--ink);
  }
  .area-card p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--brown-dark);
  }
  .area-card a {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .area-card:hover {
    border-color: var(--gold);
  }
</style>