---
interface Props {
  titulo: string;
  data: string;
  autor: string;
  categoria: string;
  resumo: string;
  href: string;
}
const { titulo, data, autor, categoria, resumo, href } = Astro.props;
---

<article class="insight-card reveal">
  <a href={href}>
    <div class="insight-meta">
      <time>{data}</time>
      <span class="insight-categoria">{categoria}</span>
      <span class="insight-autor">por {autor}</span>
    </div>
    <h3>{titulo}</h3>
    <p>{resumo}</p>
  </a>
</article>

<style>
  .insight-card {
    border: 1px solid var(--border-default);
    border-radius: 6px;
    padding: var(--space-3);
    background: var(--surface-page);
    transition: border-color 0.2s ease;
  }
  .insight-card h3 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    margin: var(--space-1) 0 var(--space-2) 0;
    color: var(--text-primary);
  }
  .insight-card p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-secondary);
  }
  .insight-card a {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .insight-card:hover {
    border-color: var(--border-accent);
  }
  .insight-meta {
    display: flex;
    gap: var(--space-2);
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-1);
    flex-wrap: wrap;
  }
  .insight-meta time,
  .insight-meta span {
    white-space: nowrap;
  }
  .insight-categoria {
    border: 1px solid var(--border-default);
    border-radius: 3px;
    padding: 0.1rem 0.4rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>