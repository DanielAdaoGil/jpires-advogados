---
interface Props {
  titulo: string;
  data: string;
  area: string;
  resumo: string;
  href: string;
}
const { titulo, data, area, resumo, href } = Astro.props;
---

<article class="noticia-card reveal">
  <a href={href}>
    <div class="noticia-meta">
      <time>{data}</time>
      <span class="noticia-area">{area}</span>
    </div>
    <h3>{titulo}</h3>
    <p>{resumo}</p>
  </a>
</article>

<style>
  .noticia-card {
    border: 1px solid var(--brown-medium);
    border-radius: 6px;
    padding: var(--space-3);
    background: var(--paper);
    transition: border-color 0.2s ease;
  }
  .noticia-card h3 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    margin: var(--space-1) 0 var(--space-2) 0;
    color: var(--ink);
  }
  .noticia-card p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--brown-dark);
  }
  .noticia-card a {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .noticia-card:hover {
    border-color: var(--gold);
  }
  .noticia-meta {
    display: flex;
    gap: var(--space-2);
    font-size: 0.85rem;
    color: var(--brown-dark);
    margin-bottom: var(--space-1);
    flex-wrap: wrap;
  }
  .noticia-area {
    border: 1px solid var(--brown-medium);
    border-radius: 3px;
    padding: 0.1rem 0.4rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>