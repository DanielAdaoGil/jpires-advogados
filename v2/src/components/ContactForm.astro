---
import { site } from '../data/site.ts';
import { t, type Lang } from '../i18n/index.ts';

interface Props {
  lang: Lang;
}

const { lang = 'pt' } = Astro.props;
const endpoint = `https://formsubmit.co/ajax/${site.email}`;
---

<form
  class="contact-form"
  method="POST"
  action={`https://formsubmit.co/${site.email}`}
  data-endpoint={endpoint}
  novalidate
  aria-label={t(lang, 'contactos.formulario.titulo')}
>
  <h2 class="contact-form__title">{t(lang, 'contactos.formulario.titulo')}</h2>

  <!-- Configuração do Formsubmit.co: não é visível para o visitante. -->
  <input type="hidden" name="_subject" value="Contacto através do site — JPires" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_url" value="" />
  <input type="hidden" name="telefoneCompleto" id="telefone-completo" value="" />
  <input type="hidden" name="pais" id="pais" value="AO" />
  <input
    class="form-honey"
    type="text"
    name="_honey"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <div class="form-group">
    <label for="nome">{t(lang, 'contactos.formulario.nome')}</label>
    <input
      id="nome"
      name="nome"
      type="text"
      required
      minlength="2"
      aria-required="true"
    />
    <span class="form-error" aria-live="polite"></span>
  </div>

  <div class="form-group">
    <label for="email">{t(lang, 'contactos.formulario.email')}</label>
    <input
      id="email"
      name="email"
      type="email"
      required
      aria-required="true"
    />
    <span class="form-error" aria-live="polite"></span>
  </div>

  <div class="form-group">
    <label for="telefone">{t(lang, 'contactos.formulario.telefone')}</label>
    <div data-no-translate>
      <input
        id="telefone"
        name="telefone"
        type="tel"
        inputmode="numeric"
        maxlength="19"
        autocomplete="tel"
        aria-describedby="erro-telefone"
      />
    </div>
    <span class="form-error" id="erro-telefone" aria-live="polite"></span>
  </div>

  <div class="form-group">
    <label for="mensagem">{t(lang, 'contactos.formulario.mensagem')}</label>
    <textarea
      id="mensagem"
      name="mensagem"
      required
      minlength="10"
      rows="6"
      aria-required="true"
    ></textarea>
    <span class="form-error" aria-live="polite"></span>
  </div>

  <div class="form-actions">
    <button
      type="submit"
      class="btn btn-primary"
      id="btn-enviar"
    >
      {t(lang, 'contactos.formulario.enviar')}
    </button>
  </div>

  <div
    id="form-mensagem"
    role="status"
    aria-live="polite"
    class="form-message"
    data-no-translate
  ></div>
</form>

<script>
  import { obterIdioma, traduzir } from '../i18n/runtime.ts';
  import {
    iniciarTelefone,
    telefoneValido,
    numeroTelefone,
    paisTelefone,
    limparTelefone,
  } from '../scripts/telefone.ts';

  const form = document.querySelector<HTMLFormElement>('.contact-form');
  const btnEnviar = document.querySelector<HTMLButtonElement>('#btn-enviar');
  const mensagem = document.querySelector<HTMLDivElement>('#form-mensagem');
  const urlOculta = form?.querySelector<HTMLInputElement>('input[name="_url"]');
  const telefone = document.querySelector<HTMLInputElement>('#telefone');
  const erroTelefone = document.querySelector<HTMLElement>('#erro-telefone');
  const telefoneCompleto = document.querySelector<HTMLInputElement>('#telefone-completo');
  const pais = document.querySelector<HTMLInputElement>('#pais');

  iniciarTelefone(telefone);

  // Textos originais em PT; o motor de idiomas traduz consoante a escolha do visitante.
  const TEXTO_OBRIGATORIO = 'Por favor, preencha todos os campos obrigatórios correctamente.';
  const TEXTO_TELEFONE = 'Número de telefone inválido para o país escolhido.';
  const TEXTO_ENVIANDO = 'A enviar mensagem...';
  const TEXTO_SUCESSO = 'Mensagem enviada com sucesso. Entraremos em contacto brevemente.';
  const TEXTO_ERRO =
    'Erro ao enviar a mensagem. Tente novamente ou contacte-nos directamente.';

  let estado = null;

  function mostrar(textoOriginal, tipo) {
    estado = { textoOriginal, tipo };
    if (!mensagem) return;
    const texto = traduzir(textoOriginal, obterIdioma());
    mensagem.textContent = texto;
    mensagem.className = 'form-message ' + tipo;
    mensagem.setAttribute('aria-label', texto);
  }

  function limpar() {
    estado = null;
    if (!mensagem) return;
    mensagem.textContent = '';
    mensagem.className = 'form-message';
    mensagem.removeAttribute('aria-label');
  }

  // O telefone é opcional, mas se preenchido tem de ser válido para o país escolhido.
  async function validarTelefone(): Promise<boolean> {
    if (!telefone || !telefone.value.trim()) {
      if (erroTelefone) erroTelefone.textContent = '';
      if (telefoneCompleto) telefoneCompleto.value = '';
      return true;
    }

    const valido = await telefoneValido(telefone);
    const erro = valido ? '' : traduzir(TEXTO_TELEFONE, obterIdioma());
    if (erroTelefone) erroTelefone.textContent = erro;
    if (pais) pais.value = paisTelefone(telefone).toUpperCase();
    if (telefoneCompleto) telefoneCompleto.value = await numeroTelefone(telefone);
    return valido;
  }

  telefone?.addEventListener('input', () => {
    telefone.setCustomValidity('');
    if (erroTelefone) erroTelefone.textContent = '';
  });

  // Se o visitante mudar de idioma com a mensagem ainda no ecrã, actualiza-a.
  document.addEventListener('jp:lang', () => {
    if (estado) mostrar(estado.textoOriginal, estado.tipo);
    if (telefone?.value.trim()) void validarTelefone();
  });

  // O Formsubmit usa este campo para identificar a página de origem.
  if (urlOculta) {
    const url = window.location.href;
    urlOculta.setAttribute('value', url);
    urlOculta.value = url;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    limpar();
    telefone?.setCustomValidity('');

    if (!form.checkValidity()) {
      mostrar(TEXTO_OBRIGATORIO, 'erro');
      form.reportValidity();
      return;
    }

    if (!(await validarTelefone())) {
      const erro = traduzir(TEXTO_TELEFONE, obterIdioma());
      telefone?.setCustomValidity(erro);
      mostrar(erro, 'erro');
      return;
    }

    if (btnEnviar) btnEnviar.disabled = true;
    mostrar(TEXTO_ENVIANDO, 'enviando');

    try {
      const resposta = await fetch(form.dataset.endpoint, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
        // Envia a URL completa como referência; alguns servidores exigem-na.
        referrerPolicy: 'no-referrer-when-downgrade',
      });

      let dados = null;
      try {
        dados = await resposta.json();
      } catch {
        // Algumas respostas de erro não vêm em JSON; o código HTTP decide.
      }

      // O Formsubmit pode responder 200 com success: "false" (ex.: formulário
      // ainda não activado). Só dizemos "enviado" quando ele confirma.
      const confirmado =
        resposta.ok && (!dados || String(dados.success).toLowerCase() === 'true');

      if (!confirmado) {
        // Diagnóstico discreto para o administrador (não aparece na página).
        console.warn(
          '[JPires] Formsubmit recusou o envio:',
          dados?.message ?? `HTTP ${resposta.status}`
        );
        throw new Error('Envio recusado pelo Formsubmit');
      }

      form.reset();
      limparTelefone(telefone);
      if (pais) pais.value = 'AO';
      if (telefoneCompleto) telefoneCompleto.value = '';
      if (urlOculta) {
        const url = window.location.href;
        urlOculta.value = url;
      }
      mostrar(TEXTO_SUCESSO, 'sucesso');
    } catch {
      mostrar(TEXTO_ERRO, 'erro');
    } finally {
      if (btnEnviar) btnEnviar.disabled = false;
    }
  });
</script>

<style>
  .contact-form {
    box-sizing: border-box;
    width: 100%;
    padding: clamp(1.5rem, 3vw, 2.75rem);
    border: 1px solid var(--border-default);
    border-radius: 8px;
    background: var(--surface-dark);
    box-shadow: var(--shadow-form);
  }

  .contact-form__title {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    color: var(--text-accent-on-dark);
    margin: 0 0 var(--space-4);
  }

  .form-group {
    margin-bottom: var(--space-4);
  }

  .form-group label {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    color: var(--text-secondary-on-dark);
    margin-bottom: var(--space-2);
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    box-sizing: border-box;
    min-height: 3.25rem;
    padding: 0.9rem 1rem;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    border: 1px solid var(--border-field);
    border-radius: 6px;
    background: var(--surface-glass);
    color: var(--text-on-dark);
  }

  .form-group textarea {
    min-height: 9rem;
    resize: vertical;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--text-field-placeholder);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: 3px solid var(--focus-ring-on-dark);
    outline-offset: 2px;
    border-color: var(--border-accent-light);
    background: var(--surface-glass-strong);
  }

  .form-group input:invalid:not(:placeholder-shown),
  .form-group textarea:invalid:not(:placeholder-shown) {
    border-color: var(--border-danger);
  }

  .form-error {
    display: none;
    font-size: 0.85rem;
    color: var(--text-danger);
    margin-top: 0.4rem;
  }

  .form-error:not(:empty) {
    display: block;
  }

  .form-group input:invalid:not(:placeholder-shown) ~ .form-error,
  .form-group textarea:invalid:not(:placeholder-shown) ~ .form-error {
    display: block;
  }

  .form-actions {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .form-message {
    margin-top: var(--space-4);
    padding: 0.9rem 1rem;
    border-radius: 6px;
    font-size: 0.95rem;
    display: none;
  }

  .form-message.sucesso {
    display: block;
    background: var(--surface-accent);
    color: var(--text-on-accent);
  }

  .form-message.erro {
    display: block;
    background: var(--surface-danger);
    border: 1px solid var(--border-danger);
    color: var(--text-danger-strong);
  }

  .form-message.enviando {
    display: block;
    background: var(--surface-glass-strong);
    border: 1px solid var(--border-accent-soft);
    color: var(--text-secondary-on-dark);
  }

  .form-honey {
    display: none;
  }

  .btn-primary {
    background: var(--surface-accent);
    color: var(--text-on-accent);
    border: none;
    padding: 0.85rem 1.75rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    border-radius: 6px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
  }

  .btn-primary:hover {
    background: var(--surface-accent-light);
  }

  .btn-primary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
</style>
