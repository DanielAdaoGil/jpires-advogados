---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { t, type Lang } from '../../i18n/index.ts';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias');
  return noticias.map((entry) => ({
    params: { slug: toSlug(entry.id) },
    props: { entry, lang: 'pt' as Lang },
  }));
}

const { entry, lang } = Astro.props;
const { Content } = await render(entry);
const noticia = entry.data;
const dataStr = noticia.data.toISOString().split('T')[0];
---

<BaseLayout title={noticia.titulo} lang={lang} current="/noticias/">
  <section class="section">
    <div class="container">
      <article class="noticia-detail">
        <div class="noticia-meta">
          <time>{dataStr}</time>
          <span class="noticia-area">{noticia.area}</span>
        </div>
        <h1>{noticia.titulo}</h1>
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .noticia-detail {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }
  .noticia-meta {
    display: flex;
    gap: var(--space-2);
    font-size: 0.85rem;
    color: var(--brown-dark);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }
  .noticia-meta time,
  .noticia-meta span {
    white-space: nowrap;
  }
  .noticia-area {
    border: 1px solid var(--brown-medium);
    border-radius: 3px;
    padding: 0.1rem 0.4rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .noticia-detail h1 {
    font-family: var(--font-heading);
    font-size: 2rem;
    color: var(--ink);
    margin-bottom: var(--space-3);
  }
</style>