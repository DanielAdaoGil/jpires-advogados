---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import PersonCard from '../../components/PersonCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BackLink from '../../components/BackLink.astro';
import { t, type Lang } from '../../i18n/index.ts';
import { toSlug } from '../../utils/slug.ts';
import { withBase } from '../../utils/url.ts';

export async function getStaticPaths() {
  const areas = await getCollection('areas');
  return areas.map((entry) => ({
    params: { slug: toSlug(entry.id) },
    props: { entry, lang: 'pt' as Lang },
  }));
}

const { entry, lang } = Astro.props;
const { Content } = await render(entry);
const area = entry.data;

const equipaCollection = await getCollection('equipa');
const areaAdvogados = area.advogados
  .map((id) => equipaCollection.find((e) => toSlug(e.id) === toSlug(id)))
  .filter(Boolean);
---

<BaseLayout title={area.titulo} lang={lang} current="/areas/">
  <section class="section">
    <div class="container">
      <BackLink href={withBase('/areas/')} lang={lang} />

      <SectionHeading title={area.titulo} level={1} />
      <p class="entry-resumo">{area.resumo}</p>
      <Content />

      {areaAdvogados.length > 0 && (
        <section class="area-equipa">
          <h2>{t(lang, 'area.equipa')}</h2>
          <div class="person-grid">
            {areaAdvogados.map((pessoa) => (
              <PersonCard
                nome={pessoa.data.nome}
                cargo={pessoa.data.cargo}
                iniciais={pessoa.data.iniciais}
                href={withBase(`/equipa/${toSlug(pessoa.id)}/`)}
              />
            ))}
          </div>
        </section>
      )}

      <div class="area-actions">
        <a href={withBase('/contactos/')} class="btn btn-primary">{t(lang, 'common.contactar')}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .area-equipa {
    margin-top: var(--space-6);
    border-top: 1px solid var(--border-default);
    padding-top: var(--space-4);
  }
  .area-equipa h2 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }
  .person-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-3);
  }
  .area-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
</style>