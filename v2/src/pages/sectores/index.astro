---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import SectorCard from '../../components/SectorCard.astro';
import { t } from '../../i18n/index.ts';
import { toSlug } from '../../utils/slug.ts';
import { withBase } from '../../utils/url.ts';

const sectores = await getCollection('sectores');
const lang = 'pt';
---

<BaseLayout title={t(lang, 'nav.sectores')} lang={lang} current="/sectores/">
  <section class="section">
    <div class="container">
      <h2 class="section-heading__title">{t(lang, 'sectores.titulo')}</h2>
      <div class="sector-grid">
        {sectores
          .sort((a, b) => a.data.ordem - b.data.ordem)
          .map((s) => (
            <SectorCard
              titulo={s.data.titulo}
              resumo={s.data.resumo}
              href={withBase(`/sectores/${toSlug(s.id)}/`)}
            />
          ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sector-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
</style>
