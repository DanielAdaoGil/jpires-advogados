---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { t, type Lang } from '../../i18n/index.ts';

export async function getStaticPaths() {
  const insights = await getCollection('insights');
  return insights.map((entry) => ({
    params: { slug: toSlug(entry.id) },
    props: { entry, lang: 'pt' as Lang },
  }));
}

const { entry, lang } = Astro.props;
const { Content } = await render(entry);
const insight = entry.data;
const dataStr = insight.data.toISOString().split('T')[0];
---

<BaseLayout title={insight.titulo} lang={lang} current="/insights/">
  <section class="section">
    <div class="container">
      <article class="insight-detail">
        <div class="insight-meta">
          <time>{dataStr}</time>
          <span class="insight-categoria">{insight.categoria}</span>
          <span class="insight-autor">por {insight.autor}</span>
        </div>
        <h1>{insight.titulo}</h1>
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .insight-detail {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }
  .insight-meta {
    display: flex;
    gap: var(--space-2);
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }
  .insight-meta time,
  .insight-meta span {
    white-space: nowrap;
  }
  .insight-categoria {
    border: 1px solid var(--border-default);
    border-radius: 3px;
    padding: 0.1rem 0.4rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .insight-detail h1 {
    font-family: var(--font-heading);
    font-size: 2rem;
    color: var(--text-primary);
    margin-bottom: var(--space-3);
  }
</style>