---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, type TranslationKey } from '../../i18n/index.ts';
import SectionHeading from '../../components/SectionHeading.astro';
import AlliancesMap from '../../components/AlliancesMap.astro';
import PrincipioModal from '../../components/PrincipioModal.astro';

const lang = 'pt';

const passos: Array<{ numero: string; titulo: TranslationKey; descricao: TranslationKey }> = [
  {
    numero: '01',
    titulo: 'sobre.metodo.passos.conhecimento.titulo',
    descricao: 'sobre.metodo.passos.conhecimento.descricao',
  },
  {
    numero: '02',
    titulo: 'sobre.metodo.passos.verificacao.titulo',
    descricao: 'sobre.metodo.passos.verificacao.descricao',
  },
  {
    numero: '03',
    titulo: 'sobre.metodo.passos.proposta.titulo',
    descricao: 'sobre.metodo.passos.proposta.descricao',
  },
  {
    numero: '04',
    titulo: 'sobre.metodo.passos.execucao.titulo',
    descricao: 'sobre.metodo.passos.execucao.descricao',
  },
  {
    numero: '05',
    titulo: 'sobre.metodo.passos.conclusao.titulo',
    descricao: 'sobre.metodo.passos.conclusao.descricao',
  },
];
---

<BaseLayout title={t(lang, 'nav.sobre')} lang={lang} current="/sobre/">
  <section class="section">
    <div class="container">
      <SectionHeading title={t(lang, 'nav.sobre')} description={t(lang, 'sobre.missao')} level={1} />

      <SectionHeading title={t(lang, 'sobre.valores.titulo')} level={2} />
      <div class="valores-grid">
        <button type="button" class="valor-card" data-principio="rigor" aria-haspopup="dialog">
          <h3>{t(lang, 'sobre.valores.rigor.nome')}</h3>
          <p>{t(lang, 'sobre.valores.rigor.descricao')}</p>
          <span class="valor-card__mais" aria-hidden="true">
            {t(lang, 'sobre.principios.saberMais')} <span>→</span>
          </span>
        </button>
        <button type="button" class="valor-card" data-principio="confianca" aria-haspopup="dialog">
          <h3>{t(lang, 'sobre.valores.confianca.nome')}</h3>
          <p>{t(lang, 'sobre.valores.confianca.descricao')}</p>
          <span class="valor-card__mais" aria-hidden="true">
            {t(lang, 'sobre.principios.saberMais')} <span>→</span>
          </span>
        </button>
        <button type="button" class="valor-card" data-principio="proximidade" aria-haspopup="dialog">
          <h3>{t(lang, 'sobre.valores.pragmatismo.nome')}</h3>
          <p>{t(lang, 'sobre.valores.pragmatismo.descricao')}</p>
          <span class="valor-card__mais" aria-hidden="true">
            {t(lang, 'sobre.principios.saberMais')} <span>→</span>
          </span>
        </button>
        <button type="button" class="valor-card" data-principio="responsabilidade" aria-haspopup="dialog">
          <h3>{t(lang, 'sobre.valores.parceria.nome')}</h3>
          <p>{t(lang, 'sobre.valores.parceria.descricao')}</p>
          <span class="valor-card__mais" aria-hidden="true">
            {t(lang, 'sobre.principios.saberMais')} <span>→</span>
          </span>
        </button>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="metodo">
    <div class="container">
      <p class="metodo-eyebrow reveal">{t(lang, 'sobre.metodo.titulo')}</p>
      <SectionHeading title={t(lang, 'sobre.metodo.subtitulo')} description={t(lang, 'sobre.metodo.intro')} level={2} />

      <ol class="metodo-grid">
        {
          passos.map((passo) => (
            <li class="metodo-passo reveal">
              <span class="metodo-passo__numero" aria-hidden="true">{passo.numero}</span>
              <h3>{t(lang, passo.titulo)}</h3>
              <p>{t(lang, passo.descricao)}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="aliancas">
    <div class="container">
      <SectionHeading
        title={t(lang, 'sobre.aliancas.titulo')}
        description={t(lang, 'sobre.aliancas.intro')}
        level={2}
      />
      <AlliancesMap lang={lang} />
    </div>
  </section>

  <PrincipioModal lang={lang} />
</BaseLayout>

<style>
  .valores-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .valor-card {
    box-sizing: border-box;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    border: 1px solid var(--border-default);
    border-radius: 6px;
    padding: var(--space-3);
    background: var(--surface-page);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .valor-card:hover,
  .valor-card:focus-visible {
    border-color: var(--border-accent);
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-soft);
  }

  .valor-card__mais {
    margin-top: auto;
    padding-top: var(--space-3);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .valor-card__mais span {
    margin-left: 0.35rem;
    color: var(--text-accent);
  }

  .valor-card:hover .valor-card__mais,
  .valor-card:focus-visible .valor-card__mais {
    color: var(--text-primary);
  }

  .valor-card h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-primary);
    margin: 0 0 var(--space-1) 0;
  }

  .valor-card p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .metodo-eyebrow {
    margin: 0 0 var(--space-1);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .metodo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: metodo;
  }

  .metodo-passo {
    border-top: 2px solid var(--border-accent);
    padding-top: var(--space-2);
  }

  .metodo-passo__numero {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-accent);
    line-height: 1;
  }

  .metodo-passo h3 {
    margin: var(--space-2) 0 var(--space-1);
    font-family: var(--font-heading);
    font-size: 1.05rem;
    color: var(--text-primary);
  }

  .metodo-passo p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }
</style>
