---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { t, type Lang } from '../../i18n/index.ts';
import SectionHeading from '../../components/SectionHeading.astro';
import { toSlug } from '../../utils/slug.ts';

export async function getStaticPaths() {
  const equipa = await getCollection('equipa');
  return equipa.map((entry) => ({
    params: { slug: toSlug(entry.id) },
    props: { entry, lang: 'pt' as Lang },
  }));
}

const { entry, lang } = Astro.props;
const { Content } = await render(entry);
const pessoa = entry.data;
---

<BaseLayout title={pessoa.nome} lang={lang} current="/equipa/">
  <section class="section">
    <div class="container">
      <SectionHeading title={pessoa.nome} level={1} />
      <p class="person-cargo">{pessoa.cargo}</p>
      <Content />
    </div>
  </section>
</BaseLayout>

<style>
  .person-cargo {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    color: var(--brown-dark);
    margin: 0 0 var(--space-3) 0;
  }
</style>